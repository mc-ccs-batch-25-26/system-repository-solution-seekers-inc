# Copy this file to backend/.env for local development.
# Do not commit backend/.env.

DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional JWT and throttling overrides.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
JWT_COOKIE_SAMESITE=Lax
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=10/minute

# Local data is stored in backend/db.sqlite3.
